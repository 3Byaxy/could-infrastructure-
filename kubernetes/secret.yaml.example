# kubernetes/secret.yaml.example
# This file is a TEMPLATE – do NOT apply it as-is.
# Replace the base64 values with your real credentials before applying.
#
# To generate base64 values:
#   echo -n "postgresql://user:pass@host:5432/dbname" | base64
#
# Apply with:
#   kubectl apply -f kubernetes/secret.yaml   (after filling in real values)
#
# Or use kubectl to create the secret directly (recommended):
#   kubectl create secret generic backend-secrets \
#     --from-literal=database-url="postgresql://user:pass@host:5432/dbname" \
#     -n cloud-infra

apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  namespace: cloud-infra
type: Opaque
data:
  # base64-encoded value of your DATABASE_URL connection string
  database-url: <BASE64_ENCODED_DATABASE_URL>
