# 🐳 DOCKERFILE
#
# A Dockerfile is a recipe that tells Docker how to build a container image.
# Each line is a step in the recipe. When you run `docker build`, Docker
# follows these steps in order.
#
# 💡 Analogy: Think of Docker like a lunchbox — this Dockerfile is the recipe
# for packing the perfect lunchbox with everything your app needs to run anywhere!

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FROM — Pick a base image to start from.
# We use the official Node.js 20 image built on Alpine Linux.
# Alpine is tiny (only ~5MB!) which keeps our container small and fast.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
FROM node:20-alpine

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LABEL — Add metadata (information) to the image.
# Like writing your name on your lunchbox!
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
LABEL maintainer="3Byaxy"
LABEL description="Cloud Infrastructure sample web application"
LABEL version="1.0"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# WORKDIR — Set the working directory INSIDE the container.
# All future commands run from this folder.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
WORKDIR /app

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# COPY — Copy files from your computer INTO the container.
# We copy package.json FIRST (before the rest of the code) so Docker
# can cache the npm install step. This speeds up future builds!
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
COPY package*.json ./

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RUN — Run a command while building the image.
# This installs our Node.js dependencies (like installing apps on your phone).
# --omit=dev skips development-only packages to keep the image small.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RUN npm install --omit=dev

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# COPY — Now copy the rest of the application code.
# We do this AFTER npm install so code changes don't invalidate the cache.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
COPY . .

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ENV — Set environment variables inside the container.
# These are like settings the app can read while it's running.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ENV NODE_ENV=production
ENV PORT=8080

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# EXPOSE — Tell Docker which port the app listens on.
# This doesn't actually open the port — it's just documentation!
# You still need to use -p when running the container.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EXPOSE 8080

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# USER — Switch to a non-root user for security.
# Running as root in a container is like running your whole computer as admin — risky!
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
USER node

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CMD — The command that runs when the container STARTS.
# This is what kicks off your application!
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
CMD ["node", "server.js"]
